local function saveSession()
    pcall(function()
        LocalPlayer:SetAttribute("Ch2Ultimate_Theme", State.Theme)
        LocalPlayer:SetAttribute("Ch2Ultimate_Lite", State.LiteMode)
        LocalPlayer:SetAttribute("Ch2Ultimate_Sort", State.SortAZ)
        LocalPlayer:SetAttribute("Ch2Ultimate_FavsOnly", State.FavoritesOnly)
        LocalPlayer:SetAttribute("Ch2Ultimate_Scale", State.Scale)
        LocalPlayer:SetAttribute("Ch2Ultimate_Mode", State.Mode)
        LocalPlayer:SetAttribute("Ch2Ultimate_LayoutMode", State.LayoutMode)
        LocalPlayer:SetAttribute("Ch2Ultimate_BringMethod", State.BringMethod)
        if State.Position then
            LocalPlayer:SetAttribute("Ch2Ultimate_PosX", State.Position.X.Offset)
            LocalPlayer:SetAttribute("Ch2Ultimate_PosY", State.Position.Y.Offset)
        end
        local bindings = {}
        for _, item in ipairs(CH2_ITEMS) do
            local key = State.ItemKeys[item.Name] or "None"
            table.insert(bindings, item.Name .. "=" .. key)
        end
        LocalPlayer:SetAttribute("Ch2Ultimate_Keybinds", table.concat(bindings, ";"))

        local fav = {}
        for key, value in pairs(State.Favorites) do
            if value then table.insert(fav, key) end
        end
        LocalPlayer:SetAttribute("Ch2Ultimate_Favorites", table.concat(fav, ","))
    end)
end

local function loadSession()
    pcall(function()
        local savedTheme = LocalPlayer:GetAttribute("Ch2Ultimate_Theme")
        local savedLite = LocalPlayer:GetAttribute("Ch2Ultimate_Lite")
        local savedSort = LocalPlayer:GetAttribute("Ch2Ultimate_Sort")
        local savedFavsOnly = LocalPlayer:GetAttribute("Ch2Ultimate_FavsOnly")
        local savedScale = LocalPlayer:GetAttribute("Ch2Ultimate_Scale")
        local savedMode = LocalPlayer:GetAttribute("Ch2Ultimate_Mode")
        local savedLayoutMode = LocalPlayer:GetAttribute("Ch2Ultimate_LayoutMode")
        local px = LocalPlayer:GetAttribute("Ch2Ultimate_PosX")
        local py = LocalPlayer:GetAttribute("Ch2Ultimate_PosY")

        if typeof(savedTheme) == "string" and THEMES[savedTheme] then State.Theme = savedTheme end
        if typeof(savedLite) == "boolean" then State.LiteMode = savedLite end
        if typeof(savedSort) == "boolean" then State.SortAZ = savedSort end
        if typeof(savedFavsOnly) == "boolean" then State.FavoritesOnly = savedFavsOnly end
        if typeof(savedScale) == "number" then State.Scale = math.clamp(savedScale, 0.75, 1.25) end
        if savedMode == "Ch2" or savedMode == "Granny" then State.Mode = savedMode end
        if savedLayoutMode == "Auto" or savedLayoutMode == "Mobile" or savedLayoutMode == "Desktop" then State.LayoutMode = savedLayoutMode end
        local savedBringMethod = LocalPlayer:GetAttribute("Ch2Ultimate_BringMethod")
        if savedBringMethod == "Local" or savedBringMethod == "Remote" then State.BringMethod = savedBringMethod end
        if typeof(px) == "number" and typeof(py) == "number" then
            State.Position = UDim2.new(0.5, px, 0.5, py)
        end

        local bindingString = LocalPlayer:GetAttribute("Ch2Ultimate_Keybinds")
        if typeof(bindingString) == "string" and bindingString ~= "" then
            table.clear(State.Keybinds)
            for _, savedItem in ipairs(CH2_ITEMS) do
                State.ItemKeys[savedItem.Name] = "None"
            end
            for pair in string.gmatch(bindingString, "[^;]+") do
                local itemName, keyName = string.match(pair, "^(.-)=(.+)$")
                if itemName and keyName then
                    local validItem = false
                    for _, item in ipairs(CH2_ITEMS) do
                        if item.Name == itemName then
                            validItem = true
                            break
                        end
                    end
                    if validItem and (keyName == "None" or not State.Keybinds[keyName]) then
                        local oldKey = State.ItemKeys[itemName]
                        if oldKey and oldKey ~= "None" then State.Keybinds[oldKey] = nil end
                        State.ItemKeys[itemName] = keyName
                        if keyName ~= "None" then State.Keybinds[keyName] = itemName end
                    end
                end
            end
        end

        local favString = LocalPlayer:GetAttribute("Ch2Ultimate_Favorites")
        if typeof(favString) == "string" and favString ~= "" then
            for token in string.gmatch(favString, "[^,]+") do
                State.Favorites[token] = true
            end
        end
    end)
end

local function disconnectAll(list)
    for _, connection in ipairs(list) do
        if connection and connection.Disconnect then
            connection:Disconnect()
        end
    end
    table.clear(list)
end

local function tween(instance, info, properties)
    local t = TweenService:Create(instance, info, properties)
    t:Play()
    return t
end

local function normalize(s)
    return string.lower(tostring(s))
end

local function isTextBoxFocused()
    return UserInputService:GetFocusedTextBox() ~= nil
end

local function getRootPart()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

local function objectHasPart(instance)
    if instance:IsA("BasePart") then
        return true
    end

    if instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("Folder") then
        return instance:FindFirstChildWhichIsA("BasePart", true) ~= nil
    end

    return false
end

local function getMovementPart(instance)
    if instance:IsA("BasePart") then
        return instance
    end

    if instance:IsA("Tool") then
        local handle = instance:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            return handle
        end
    end

    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function isExcludedFromNestedResult(candidate, exactName)
    local parent = candidate.Parent
    while parent and parent ~= workspace do
        if (parent:IsA("Model") or parent:IsA("Tool")) and parent.Name == exactName then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function findMatches(itemName)
    local exact = {}
    local loose = {}

    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance.Name == itemName and not isExcludedFromNestedResult(instance, itemName) and objectHasPart(instance) then
            table.insert(exact, instance)
        end
    end

    if #exact > 0 then
        return exact
    end

    local wanted = normalize(itemName)
    for _, instance in ipairs(workspace:GetDescendants()) do
        if normalize(instance.Name) == wanted and not isExcludedFromNestedResult(instance, instance.Name) and objectHasPart(instance) then
            table.insert(loose, instance)
        end
    end

    return loose
end

local function findFirst(itemName, used)
    local matches = findMatches(itemName)
    for _, instance in ipairs(matches) do
        if not used or not used[instance] then
            return instance
        end
    end
    return nil
end

local function moveInstance(instance)
    local root = getRootPart()
    if not root then
        return false, "Character root not found"
    end

    if not instance or not instance.Parent then
        return false, "Item no longer exists"
    end

    local destination = root.CFrame * CFrame.new(0, 3, 0)

    local ok, err = pcall(function()
        if instance:IsA("Model") then
            instance:PivotTo(destination)
        elseif instance:IsA("BasePart") then
            instance.CFrame = destination
        elseif instance:IsA("Tool") then
            local handle = instance:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                handle.CFrame = destination
            else
                local part = getMovementPart(instance)
                if not part then
                    error("No movable BasePart found")
                end
                part.CFrame = destination
            end
        else
            local model = instance:FindFirstAncestorWhichIsA("Model")
            if model then
                model:PivotTo(destination)
            else
                local part = getMovementPart(instance)
                if not part then
                    error("No movable BasePart found")
                end
                part.CFrame = destination
            end
        end
    end)

    if not ok then
        return false, tostring(err)
    end

    return true, "Brought"
end

local function itemExists(itemName)
    return #findMatches(itemName) > 0
end

