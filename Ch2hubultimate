local notificationQueue = {}
local notificationActive = false
local noteLabel
local function showNotification(msg, color)
	color = color or theme.notificationDefault
	table.insert(notificationQueue, {msg = msg, color = color})
	if not notificationActive then
		local function process()
			if #notificationQueue == 0 then
				notificationActive = false
				return
			end
			notificationActive = true
			local data = table.remove(notificationQueue,1)
			noteLabel.Text = data.msg
			noteLabel.TextColor3 = data.color
			noteLabel.TextTransparency = 1
			local tweenIn = TweenService:Create(noteLabel, TweenInfo.new(0.25), {TextTransparency=0})
			tweenIn:Play()
			tweenIn.Completed:Wait()
			task.delay(1.5,function()
				local tweenOut = TweenService:Create(noteLabel, TweenInfo.new(0.25), {TextTransparency=1})
				tweenOut:Play()
				tweenOut.Completed:Wait()
				process()
			end)
		end
		process()
	end
end

local function bringModelToPlayer(name)
	local model = findModelByName(name)
	if not model then
		showNotification("❌ "..name.." not found!", Color3.fromRGB(255,100,100))
		return
	end
	local char = getCharacter()
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pos = root.Position + Vector3.new(0,3,0)
	if not model.PrimaryPart then
		local base = model:FindFirstChildWhichIsA("BasePart")
		if base then model.PrimaryPart = base else
			showNotification("❌ "..name.." has no parts!", Color3.fromRGB(255,100,100))
			return
		end
	end
	model:SetPrimaryPartCFrame(CFrame.new(pos))
	showNotification("✅ Brought "..name.."!", Color3.fromRGB(100,255,100))
end

