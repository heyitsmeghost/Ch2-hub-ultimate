local function remoteTargets(itemName)
    local targets = {}
    local map = workspace:FindFirstChild("Map")
    if not map then return targets end

    for _, folder in ipairs(map:GetDescendants()) do
        if folder.Name == "Objects" then
            for _, object in ipairs(folder:GetChildren()) do
                local item = object:FindFirstChild("Item")
                if item then
                    if not itemName or normalize(object.Name) == normalize(itemName) or normalize(item.Name) == normalize(itemName) then
                        table.insert(targets, item)
                    end
                end
            end
        end
    end
    return targets
end

local function getRemoteEvents()
    local events = ReplicatedStorage:FindFirstChild("Events")
    if not events then
        return nil, nil, "ReplicatedStorage.Events not found"
    end
    local getEvent = events:FindFirstChild("Get")
    local dropEvent = events:FindFirstChild("Drop")
    if not getEvent or not getEvent:IsA("RemoteEvent") then
        return nil, nil, "Events.Get RemoteEvent not found"
    end
    if not dropEvent or not dropEvent:IsA("RemoteEvent") then
        return nil, nil, "Events.Drop RemoteEvent not found"
    end
    return getEvent, dropEvent, nil
end

local function remoteBringItem(itemName)
    local getEvent, dropEvent, err = getRemoteEvents()
    if not getEvent then
        notify("Remote method unavailable • " .. err, "error")
        return false
    end

    local targets = remoteTargets(itemName)
    local target = targets[1]
    if not target then
        notify("Remote target not found: " .. itemName, "error")
        return false
    end

    local ok, reason = pcall(function()
        getEvent:FireServer(LocalPlayer, target)
        task.wait()
        dropEvent:FireServer(LocalPlayer)
    end)

    if not ok then
        notify("Remote failed: " .. itemName .. " • " .. tostring(reason), "error")
        return false
    end

    notify("Remote Get/Drop: " .. itemName, "success")
    return true
end

local function remoteBringAll()
    local getEvent, dropEvent, err = getRemoteEvents()
    if not getEvent then
        notify("Remote method unavailable • " .. err, "error")
        return false
    end

    local targets = remoteTargets(nil)
    if #targets == 0 then
        notify("Remote scan found no Map.Objects items", "error")
        return false
    end

    local successful = 0
    local failed = 0
    for _, target in ipairs(targets) do
        local ok = pcall(function()
            getEvent:FireServer(LocalPlayer, target)
            task.wait()
            dropEvent:FireServer(LocalPlayer)
        end)
        if ok then
            successful += 1
        else
            failed += 1
        end
    end

    notify(string.format("Remote Bring All • %d processed • %d failed", successful, failed), successful > 0 and "success" or "error")
    refreshStatus()
    return successful > 0
end

