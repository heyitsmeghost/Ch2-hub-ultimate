local dragging, dragInput, dragStart, startPos = false,nil,nil,frame.Position
local resizing, resizeInput, resizeStart, startSize = false,nil,nil,frame.Size
local function updateDrag(input)
	local delta = input.Position - dragStart
	frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
local function updateResize(input)
	local delta = input.Position - resizeStart
	frame.Size = UDim2.new(startSize.X.Scale, math.clamp(startSize.X.Offset + delta.X, 200, 800), startSize.Y.Scale, math.clamp(startSize.Y.Offset + delta.Y, 300, 800))
end
frame.InputBegan:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
		if input.Position.X > frame.AbsolutePosition.X + frame.AbsoluteSize.X - 20 and input.Position.Y > frame.AbsolutePosition.Y + frame.AbsoluteSize.Y - 20 then
			resizing = true
			resizeStart = input.Position
			startSize = frame.Size
			input.Changed:Connect(function()
				if input.UserInputState==Enum.UserInputState.End then resizing=false end
			end)
		else
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState==Enum.UserInputState.End then dragging=false end
			end)
		end
	end
end)
frame.InputChanged:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
		dragInput = input
		resizeInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and input==dragInput then updateDrag(input) end
	if resizing and input==resizeInput then updateResize(input) end
end)

