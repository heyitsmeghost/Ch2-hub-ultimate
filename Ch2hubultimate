--==================================================

local function keyPressed(keyCode)
    if isTextBoxFocused() then
        return
    end

    if keyCode == Enum.KeyCode.L then
        toggleVisible()
        return
    end

    if keyCode == Enum.KeyCode.G then
        bringAll()
        return
    end
    if keyCode == Enum.KeyCode.R then
        if isLegacyActive() then
            restoreUltimate()
        else
            switchMode()
        end
        return
    end

    if not State.Visible then
        return
    end

    local info = currentLegacyInfo()
    if isLegacyActive() and not info.Keybinds then
        return
    end

    if State.Mode ~= "Ch2" then
        return
    end

    if keyCode == Enum.KeyCode.Slash then
        pcall(function() SearchBox:CaptureFocus() end)
        return
    end

    local itemName = State.Keybinds[keyCode.Name]
    if itemName then
        bringItem(itemName)
    end
end

table.insert(Connections, UserInputService.InputBegan:Connect(function(input)
    -- Do not check gameProcessed for keyboard: CoreGui marks our keys as processed
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    keyPressed(input.KeyCode)
end))

