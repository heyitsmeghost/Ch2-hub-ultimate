    local bindButton = settingButton(item.Name .. "  •  Key: " .. tostring(State.ItemKeys[item.Name] or "None"))
    bindButton.Size = UDim2.new(1, 0, 0, 38)
    bindButton.MouseButton1Click:Connect(function()
        local current = State.ItemKeys[item.Name] or "None"
        local currentIndex = 1
        for i, keyName in ipairs(EDIT_KEYS) do
            if keyName == current then
                currentIndex = i
                break
            end
        end

        local assigned = false
        for step = 1, #EDIT_KEYS do
            local nextIndex = ((currentIndex - 1 + step) % #EDIT_KEYS) + 1
            local candidate = EDIT_KEYS[nextIndex]
            if candidate == "None" or not State.Keybinds[candidate] or State.Keybinds[candidate] == item.Name then
                if current ~= "None" then
                    State.Keybinds[current] = nil
                end
                State.ItemKeys[item.Name] = candidate
                if candidate ~= "None" then
                    State.Keybinds[candidate] = item.Name
                end
                assigned = true
                break
            end
        end

        if assigned then
            updateKeybindButtons()
            saveSession()
            notify(item.Name .. " keybind → " .. tostring(State.ItemKeys[item.Name]), "success")
        else
            notify("No free key is available for " .. item.Name, "error")
        end
    end)
    KeybindButtons[item.Name] = bindButton
end

