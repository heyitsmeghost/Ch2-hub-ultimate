launchInstalledLegacy = function(info)
    cleanupAllLegacyGuis()
    if ActiveLegacyScript and ActiveLegacyScript.Parent then pcall(function() ActiveLegacyScript.Disabled = true end) end
    ActiveLegacyScript = nil

    local source = ORIGINAL_SOURCES[info.Version]
    if source then
        local compiler = getCompiler()
        if compiler then
            local okCompile, chunkOrErr = pcall(compiler, source, "=" .. tostring(info.RealScriptName or info.Version))
            if okCompile and type(chunkOrErr) == "function" then
                State.LegacyPreview = true
                State.Version = info.Version
                State.Mode = "Ch2"
                Main.Visible = false
                State.Visible = false
                local okRun, runErr = pcall(chunkOrErr)
                if okRun then
                    notify(info.Version .. " original launched", "success")
                    return true
                end
                cleanupAllLegacyGuis()
                State.LegacyPreview = false
                State.Version = "Ultimate"
                State.Mode = "Ch2"
                Main.Visible = true
                State.Visible = true
                notify(info.Version .. " original failed: " .. tostring(runErr), "error")
                return false
            end
            notify(info.Version .. " original could not compile: " .. tostring(chunkOrErr), "error")
            return false
        end
    end

    local script = findInstalledLegacyScript(info)
    if not script then
        notify(info.Version .. " original loader unavailable here; install the supplied LocalScript instead", "error")
        return false
    end
    ActiveLegacyScript = script
    State.LegacyPreview = true
    State.Version = info.Version
    State.Mode = "Ch2"
    Main.Visible = false
    State.Visible = false
    pcall(function() script.Disabled = false end)
    notify(info.Version .. " original launched", "success")
    return true
end

