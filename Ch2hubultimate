findInstalledLegacyScript = function(info)
    if not info or not info.RealScriptName then return nil end
    if LegacySourceFolder then
        local direct = LegacySourceFolder:FindFirstChild(info.RealScriptName, true)
        if direct and direct:IsA("LocalScript") then return direct end
    end
    for _, descendant in ipairs(CoreGui:GetDescendants()) do
        if descendant:IsA("LocalScript") and descendant.Name == info.RealScriptName then return descendant end
    end
    return nil
end

