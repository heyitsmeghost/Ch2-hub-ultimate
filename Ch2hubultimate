bringItem = function(itemName)
    if State.BringMethod == "Remote" then
        return remoteBringItem(itemName)
    end

    local instance = findFirst(itemName)
    if not instance then
        notify("Not found: " .. itemName, "error")
        return false
    end

    local ok, reason = moveInstance(instance)
    if ok then
        notify("Brought: " .. itemName, "success")
        return true
    end

    notify("Failed: " .. itemName .. " • " .. tostring(reason), "error")
    return false
end

bringAll = function()
    if State.BringMethod == "Remote" then
        return remoteBringAll()
    end

    local dataset = getDataset()
    local used = {}
    local successful = 0
    local missing = 0
    local failed = 0
    local occurrenceNeeded = {}

    -- Duplicate roster entries intentionally get their own chance to locate a distinct instance.
    for _, item in ipairs(dataset) do
        occurrenceNeeded[item.Name] = (occurrenceNeeded[item.Name] or 0) + 1
        local matches = findMatches(item.Name)
        local chosen
        local seen = occurrenceNeeded[item.Name]
        local count = 0

        for _, candidate in ipairs(matches) do
            if not used[candidate] then
                count += 1
                if count == 1 then
                    chosen = candidate
                end
                if count >= seen then
                    chosen = candidate
                    break
                end
            end
        end

        if chosen then
            local ok = moveInstance(chosen)
            if ok then
                used[chosen] = true
                successful += 1
            else
                failed += 1
            end
        else
            missing += 1
        end
    end

    notify(string.format("Bring All complete • %d brought • %d missing • %d failed", successful, missing, failed), successful > 0 and "success" or "error")
    refreshStatus()
    return successful > 0
end
