local function filteredItems()
    local result = {}
    local search = normalize(State.Search)

    for index, item in ipairs(getDataset()) do
        local categoryOK = State.Category == "All" or item.Category == State.Category
        local favoriteOK = not State.FavoritesOnly or isFavorite(index)
        local searchOK = search == "" or normalize(item.Name):find(search, 1, true) ~= nil

        if categoryOK and favoriteOK and searchOK then
            table.insert(result, {
                Index = index,
                Data = item,
            })
        end
    end

    if State.SortAZ then
        table.sort(result, function(a, b)
            local an = normalize(a.Data.Name)
            local bn = normalize(b.Data.Name)
            if an == bn then
                return a.Index < b.Index
            end
            return an < bn
        end)
    end

    return result
end

